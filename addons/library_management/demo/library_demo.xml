<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Catégories -->
        <record id="category_science_fiction" model="library.category">
            <field name="name">Science-Fiction</field>
        </record>
        <record id="category_informatique" model="library.category">
            <field name="name">Informatique</field>
        </record>

        <!-- Auteurs -->
        <record id="author_orwell" model="library.author">
            <field name="name">George Orwell</field>
            <field name="bio">Écrivain et journaliste britannique.</field>
        </record>
        <record id="author_martin" model="library.author">
            <field name="name">Robert C. Martin</field>
            <field name="bio">Software engineer et auteur de Clean Code.</field>
        </record>

        <!-- Livres -->
        <record id="book_1984" model="library.book">
            <field name="name">1984</field>
            <field name="isbn">9780451524935</field>
            <field name="category_id" ref="category_science_fiction"/>
            <field name="author_ids" eval="[(4, ref('author_orwell'))]"/>
            <field name="pages">328</field>
        </record>
        <record id="book_clean_code" model="library.book">
            <field name="name">Clean Code</field>
            <field name="isbn">9780132350884</field>
            <field name="category_id" ref="category_informatique"/>
            <field name="author_ids" eval="[(4, ref('author_martin'))]"/>
            <field name="pages">464</field>
        </record>

        <!-- Emprunts -->
        <record id="loan_demo_1" model="library.loan">
            <field name="book_id" ref="book_1984"/>
            <field name="borrower_id" ref="base.partner_admin"/>
            <field name="loan_date">2026-09-01</field>
            <field name="state">ongoing</field>
        </record>
        <record id="loan_demo_2" model="library.loan">
            <field name="book_id" ref="book_clean_code"/>
            <field name="borrower_id" ref="base.partner_admin"/>
            <field name="loan_date">2026-08-10</field>
            <field name="state">returned</field>
        </record>
    </data>
</odoo>