<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Liste des Livres -->
    <record id="view_library_book_tree" model="ir.ui.view">
        <field name="name">library.book.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="author_ids" widget="many2many_tags"/>
                <field name="category_id"/>
                <field name="isbn"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- Vue Kanban des Livres -->
    <record id="view_library_book_kanban" model="ir.ui.view">
        <field name="name">library.book.kanban</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="id"/>
                <field name="name"/>
                <field name="author_ids"/>
                <field name="image"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex">
                            <div class="me-2">
                                <field name="image" widget="image" class="o_kanban_image"/>
                            </div>
                            <div>
                                <strong><field name="name"/></strong>
                                <div><field name="author_ids" widget="many2many_tags"/></div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action Fenêtre Livres -->
    <record id="action_library_book" model="ir.actions.act_window">
        <field name="name">Livres</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,kanban,form</field>
    </record>
</odoo>