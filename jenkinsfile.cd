pipeline {
    agent any

    environment {
        DOCKER_USER = 'mhdsylla'
        IMAGE_NAME  = 'library_management'
        IMAGE       = "${DOCKER_USER}/${IMAGE_NAME}:latest"
    }

    triggers {
        upstream(upstreamProjects: 'library_management-ci', threshold: hudson.model.Result.SUCCESS)
    }

    stages {

        stage('Pull image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DOCKER_USER_VAR',
                    passwordVariable: 'DOCKER_PASS_VAR'
                )]) {
                    sh '''
                        echo "📥 Connexion à DockerHub et récupération de l'image..."
                        echo $DOCKER_PASS_VAR | docker login -u $DOCKER_USER_VAR --password-stdin
                        docker pull $IMAGE
                        echo "✅ Image récupérée : $IMAGE"
                    '''
                }
            }
        }

        stage('Redeploy') {
            steps {
                sh '''
                    echo "🛑 Arrêt de l'ancien conteneur..."
                    docker stop library_app || true
                    docker rm library_app || true

                    echo "🚀 Démarrage du nouveau conteneur..."
                    docker run -d \
                        --name library_app \
                        --link odoo-db:db \
                        -p 17100:8069 \
                        $IMAGE

                    echo "⏳ Attente du démarrage d'Odoo (15s)..."
                    sleep 15
                    echo "✅ Conteneur redéployé"
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    echo "🏥 Vérification que Odoo répond..."
                    curl -f http://localhost:17100/web/health || \
                        (echo "❌ Odoo ne répond pas !" && exit 1)
                    echo "✅ Odoo est opérationnel sur http://localhost:17100"
                '''
            }
        }
    }

    post {
        success {
            echo "🎉 Déploiement réussi — library_management est en ligne sur http://5.189.130.215:17100"
        }